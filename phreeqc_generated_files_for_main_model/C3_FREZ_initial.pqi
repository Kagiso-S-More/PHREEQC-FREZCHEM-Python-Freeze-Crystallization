    Na 21070.0000000000
    K 825.0000000000
    Mg 2760.0000000000
    Ca 957.0000000000
    Cl 39645.0000000000
    S(6) 5593.0000000000 as SO4
    Alkalinity 261.0000000000 as HCO3

SELECTED_OUTPUT 1
    -file C:/Users/Kagiso/PHREEQC-Python/C3_FREZ_initial_selected.txt
